<%- include('../../partials/header', { title: 'Trưởng bộ môn', activePage: 'department-heads' }) %>
<%- include('../../partials/sidebar') %>

<div class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <div class="breadcrumb">
        <a href="/dashboard">Trang chủ</a><span>/</span>
        <span class="current">Trưởng bộ môn</span>
      </div>
    </div>
  </div>

  <div class="page-header">
    <div>
      <div class="page-title">Trưởng bộ môn</div>
      <div class="page-subtitle">Bổ nhiệm và quản lý trưởng bộ môn</div>
    </div>
    <button class="btn btn-primary" onclick="LMS.modal.open('appointModal')">
      <i class="fa-solid fa-user-plus"></i> Bổ nhiệm
    </button>
  </div>

  <!-- Stats -->
  <div class="stats-grid" style="grid-template-columns:repeat(3,1fr);margin-bottom:24px">
    <div class="stat-card">
      <div><div class="stat-label">Tổng số</div><div class="stat-value" id="totalCount">—</div></div>
      <div class="stat-icon" style="background:rgba(79,142,247,.15);color:var(--accent)"><i class="fa-solid fa-user-tie"></i></div>
    </div>
    <div class="stat-card">
      <div><div class="stat-label">Đang hoạt động</div><div class="stat-value" id="activeCount">—</div></div>
      <div class="stat-icon" style="background:rgba(52,211,153,.15);color:var(--success)"><i class="fa-solid fa-circle-check"></i></div>
    </div>
    <div class="stat-card">
      <div><div class="stat-label">Đã kết thúc</div><div class="stat-value" id="inactiveCount">—</div></div>
      <div class="stat-icon" style="background:rgba(248,113,113,.15);color:var(--danger)"><i class="fa-solid fa-circle-xmark"></i></div>
    </div>
  </div>

  <div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
      <div class="card-title" style="margin-bottom:0"><i class="fa-solid fa-user-tie" style="color:var(--accent)"></i> Danh sách</div>
      <div style="display:flex;gap:8px">
        <button class="btn btn-secondary btn-sm" onclick="loadAll()"><i class="fa-solid fa-list"></i> Tất cả</button>
        <button class="btn btn-success btn-sm" onclick="loadActive()"><i class="fa-solid fa-circle-check"></i> Đang hoạt động</button>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>ID</th><th>Giảng viên</th><th>Bắt đầu nhiệm kỳ</th><th>Kết thúc nhiệm kỳ</th><th>Trạng thái</th><th>Thao tác</th>
          </tr>
        </thead>
        <tbody id="deptTableBody">
          <tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text-muted)"><i class="fa-solid fa-spinner fa-spin"></i></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal: Bổ nhiệm -->
<div class="modal-overlay" id="appointModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title"><i class="fa-solid fa-user-plus" style="color:var(--accent);margin-right:8px"></i>Bổ nhiệm Trưởng bộ môn</div>
      <button class="modal-close" onclick="LMS.modal.close('appointModal')"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="form-group">
      <label class="form-label">ID Giảng viên <span style="color:var(--danger)">*</span></label>
      <input type="number" id="lecturerId" class="form-control" placeholder="Nhập ID giảng viên" min="1" />
    </div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Ngày bắt đầu <span style="color:var(--danger)">*</span></label>
        <input type="date" id="termStart" class="form-control" />
      </div>
      <div class="form-group">
        <label class="form-label">Ngày kết thúc</label>
        <input type="date" id="termEnd" class="form-control" />
      </div>
    </div>
    <div class="form-actions">
      <button class="btn btn-secondary" onclick="LMS.modal.close('appointModal')">Hủy</button>
      <button class="btn btn-primary" onclick="appoint()"><i class="fa-solid fa-check"></i> Bổ nhiệm</button>
    </div>
  </div>
</div>

<!-- Modal: Cập nhật nhiệm kỳ -->
<div class="modal-overlay" id="updateModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title"><i class="fa-solid fa-pen" style="color:var(--accent);margin-right:8px"></i>Cập nhật nhiệm kỳ</div>
      <button class="modal-close" onclick="LMS.modal.close('updateModal')"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <input type="hidden" id="updateHeadId" />
    <div class="form-group">
      <label class="form-label">Ngày kết thúc nhiệm kỳ</label>
      <input type="date" id="newTermEnd" class="form-control" />
    </div>
    <div class="form-actions">
      <button class="btn btn-secondary" onclick="LMS.modal.close('updateModal')">Hủy</button>
      <button class="btn btn-primary" onclick="updateHead()"><i class="fa-solid fa-floppy-disk"></i> Lưu</button>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>

<script>
let allData = [];

function isActive(item) {
  if (!item.termEnd) return true;
  return new Date(item.termEnd) >= new Date();
}

async function loadAll() {
  try {
    allData = await LMS.api.get('/department-heads');
    renderTable(allData);
    document.getElementById('totalCount').textContent = allData.length;
    document.getElementById('activeCount').textContent = allData.filter(isActive).length;
    document.getElementById('inactiveCount').textContent = allData.filter(d => !isActive(d)).length;
  } catch(e) { showError(e.message); }
}

async function loadActive() {
  try {
    const data = await LMS.api.get('/department-heads/active');
    renderTable(data);
  } catch(e) { showError(e.message); }
}

function renderTable(data) {
  const tbody = document.getElementById('deptTableBody');
  if (!data.length) {
    tbody.innerHTML = '<tr><td colspan="6"><div class="empty-state"><i class="fa-solid fa-user-tie"></i><p>Chưa có trưởng bộ môn nào</p></div></td></tr>';
    return;
  }
  tbody.innerHTML = data.map(d => {
    const active = isActive(d);
    return `<tr>
      <td class="text-muted" style="font-family:var(--font-mono);font-size:12px">${d.id}</td>
      <td><span class="td-main">${d.lecturer?.fullname || d.lecturerId || '—'}</span></td>
      <td class="text-secondary">${d.termStart ? new Date(d.termStart).toLocaleDateString('vi-VN') : '—'}</td>
      <td class="text-secondary">${d.termEnd ? new Date(d.termEnd).toLocaleDateString('vi-VN') : 'Không xác định'}</td>
      <td><span class="badge ${active ? 'badge-green' : 'badge-gray'}">${active ? 'Đang hoạt động' : 'Đã kết thúc'}</span></td>
      <td>
        <div style="display:flex;gap:6px">
          <button class="btn btn-secondary btn-sm" onclick="openUpdate(${d.id},'${d.termEnd || ''}')" title="Cập nhật">
            <i class="fa-solid fa-pen"></i>
          </button>
          <button class="btn btn-danger btn-sm" onclick="remove(${d.id})" title="Miễn nhiệm">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </td>
    </tr>`;
  }).join('');
}

function showError(msg) {
  document.getElementById('deptTableBody').innerHTML =
    `<tr><td colspan="6"><div class="empty-state"><i class="fa-solid fa-circle-xmark"></i><p>${msg}</p></div></td></tr>`;
}

async function appoint() {
  try {
    const body = {
      lecturerId: parseInt(document.getElementById('lecturerId').value),
      termStart: document.getElementById('termStart').value,
      termEnd: document.getElementById('termEnd').value || undefined,
    };
    await LMS.api.post('/department-heads', body);
    LMS.toast('Bổ nhiệm thành công!', 'success');
    LMS.modal.close('appointModal');
    loadAll();
  } catch(e) { LMS.toast(e.message, 'error'); }
}

function openUpdate(id, termEnd) {
  document.getElementById('updateHeadId').value = id;
  document.getElementById('newTermEnd').value = termEnd ? termEnd.split('T')[0] : '';
  LMS.modal.open('updateModal');
}

async function updateHead() {
  const id = document.getElementById('updateHeadId').value;
  const termEnd = document.getElementById('newTermEnd').value;
  try {
    await LMS.api.put(`/department-heads/${id}`, { termEnd: termEnd || undefined });
    LMS.toast('Cập nhật thành công!', 'success');
    LMS.modal.close('updateModal');
    loadAll();
  } catch(e) { LMS.toast(e.message, 'error'); }
}

async function remove(id) {
  if (!LMS.confirm('Miễn nhiệm trưởng bộ môn này?')) return;
  try {
    await LMS.api.delete(`/department-heads/${id}`);
    LMS.toast('Đã miễn nhiệm!', 'success');
    loadAll();
  } catch(e) { LMS.toast(e.message, 'error'); }
}

// Set default termStart to today
document.getElementById('termStart').value = new Date().toISOString().split('T')[0];
loadAll();
</script>
