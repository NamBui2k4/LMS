<%- include('../../partials/header', { title: 'Chỉnh sửa vai trò', activePage: 'users' }) %>
<%- include('../../partials/sidebar') %>

<div class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <div class="breadcrumb">
        <a href="/dashboard">Trang chủ</a><span>/</span>
        <a href="/admin/users">Người dùng</a><span>/</span>
        <span class="current">Chỉnh sửa vai trò</span>
      </div>
    </div>
  </div>

  <div class="page-header">
    <div>
      <div class="page-title">Chỉnh sửa vai trò</div>
      <div class="page-subtitle">Thay đổi vai trò của người dùng trong hệ thống</div>
    </div>
    <a href="/admin/users" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
  </div>

  <div style="max-width:480px">
    <div class="card" id="userCard">
      <div style="text-align:center;padding:32px;color:var(--text-muted)">
        <i class="fa-solid fa-spinner fa-spin"></i> Đang tải...
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>

<script>
const userId = window.location.pathname.split('/').at(-2); // /admin/users/:id/edit-role

async function loadUser() {
  try {
    const user = await LMS.api.get(`/users/${userId}`);
    const roleLabels = { admin:'Admin', lecturer:'Giảng viên', head_of_department:'Trưởng bộ môn', student:'Học viên' };
    document.getElementById('userCard').innerHTML = `
      <div class="card-title"><i class="fa-solid fa-shield" style="color:var(--accent)"></i> Thông tin người dùng</div>
      <div style="background:var(--bg-surface);border-radius:10px;padding:16px;margin-bottom:24px;border:1px solid var(--border)">
        <div style="font-size:13px;color:var(--text-muted);margin-bottom:4px">Email</div>
        <div style="font-size:15px;font-weight:600;color:var(--text-primary)">${user.email}</div>
        <div style="margin-top:10px;font-size:13px;color:var(--text-muted)">Vai trò hiện tại</div>
        <div style="margin-top:4px"><span class="badge badge-blue">${roleLabels[user.role] || user.role}</span></div>
      </div>
      <div class="form-group">
        <label class="form-label">Vai trò mới</label>
        <select id="newRole" class="form-control">
          <option value="admin" ${user.role==='admin'?'selected':''}>Admin</option>
          <option value="lecturer" ${user.role==='lecturer'?'selected':''}>Giảng viên</option>
          <option value="head_of_department" ${user.role==='head_of_department'?'selected':''}>Trưởng bộ môn</option>
          <option value="student" ${user.role==='student'?'selected':''}>Học viên</option>
        </select>
      </div>
      <div class="form-actions">
        <a href="/admin/users" class="btn btn-secondary">Hủy</a>
        <button class="btn btn-primary" onclick="saveRole()">
          <i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi
        </button>
      </div>`;
  } catch(e) {
    document.getElementById('userCard').innerHTML = `<div class="empty-state"><i class="fa-solid fa-circle-xmark"></i><p>${e.message}</p></div>`;
  }
}

async function saveRole() {
  const role = document.getElementById('newRole').value;
  try {
    await LMS.api.patch(`/users/${userId}/role`, { role });
    LMS.toast('Cập nhật vai trò thành công!', 'success');
    setTimeout(() => window.location.href = '/admin/users', 1200);
  } catch(e) { LMS.toast(e.message, 'error'); }
}

loadUser();
</script>
