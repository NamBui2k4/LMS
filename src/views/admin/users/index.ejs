<%- include('../../partials/header', { title: 'Quản lý người dùng', activePage: 'users' }) %>
<%- include('../../partials/sidebar') %>

<div class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <div class="breadcrumb">
        <a href="/dashboard">Trang chủ</a><span>/</span>
        <a href="/admin/users">Quản trị</a><span>/</span>
        <span class="current">Người dùng</span>
      </div>
    </div>
    <div class="topbar-right">
      <div class="user-pill">
        <div class="avatar">A</div>
        <div><div class="uname">Admin</div><div class="urole">admin</div></div>
      </div>
    </div>
  </div>

  <div class="page-header">
    <div>
      <div class="page-title">Quản lý người dùng</div>
      <div class="page-subtitle">Tạo, gán vai trò và quản lý tài khoản hệ thống</div>
    </div>
    <div style="display:flex;gap:10px">
      <a href="/admin/users/create" class="btn btn-primary">
        <i class="fa-solid fa-user-plus"></i> Tạo tài khoản
      </a>
    </div>
  </div>

  <!-- Filters -->
  <div class="card" style="margin-bottom:20px;padding:16px 20px">
    <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
      <div class="search-box">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="searchInput" placeholder="Tìm theo email..." />
      </div>
      <select id="roleFilter" class="form-control" style="width:180px">
        <option value="">Tất cả vai trò</option>
        <option value="admin">Admin</option>
        <option value="lecturer">Giảng viên</option>
        <option value="head_of_department">Trưởng bộ môn</option>
        <option value="student">Học viên</option>
      </select>
      <button class="btn btn-secondary" onclick="loadUsers()"><i class="fa-solid fa-rotate"></i> Làm mới</button>
    </div>
  </div>

  <div class="card">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Email</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
            <th>Đăng nhập cuối</th>
            <th>Ngày tạo</th>
            <th>Thao tác</th>
          </tr>
        </thead>
        <tbody id="userTableBody">
          <tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text-muted)"><i class="fa-solid fa-spinner fa-spin"></i> Đang tải...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal: Gán vai trò -->
<div class="modal-overlay" id="roleModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title"><i class="fa-solid fa-shield" style="color:var(--accent);margin-right:8px"></i>Gán vai trò</div>
      <button class="modal-close" onclick="LMS.modal.close('roleModal')"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <input type="hidden" id="roleUserId" />
    <div class="form-group">
      <label class="form-label">Chọn vai trò mới</label>
      <select id="roleSelect" class="form-control">
        <option value="admin">Admin</option>
        <option value="lecturer">Giảng viên</option>
        <option value="head_of_department">Trưởng bộ môn</option>
        <option value="student">Học viên</option>
      </select>
    </div>
    <div class="form-actions">
      <button class="btn btn-secondary" onclick="LMS.modal.close('roleModal')">Hủy</button>
      <button class="btn btn-primary" id="saveRoleBtn" onclick="saveRole()">
        <i class="fa-solid fa-floppy-disk"></i> Lưu
      </button>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>

<script>
const roleLabels = { admin:'Admin', lecturer:'Giảng viên', head_of_department:'Trưởng bộ môn', student:'Học viên' };
const roleColors = { admin:'badge-red', lecturer:'badge-blue', head_of_department:'badge-yellow', student:'badge-green' };
let allUsers = [];

async function loadUsers() {
  const tbody = document.getElementById('userTableBody');
  tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text-muted)"><i class="fa-solid fa-spinner fa-spin"></i> Đang tải...</td></tr>';
  try {
    // Tìm theo email nếu có
    const emailSearch = document.getElementById('searchInput').value.trim();
    let data;
    if (emailSearch) {
      data = [await LMS.api.get(`/users/search?email=${encodeURIComponent(emailSearch)}`)];
    } else {
      // Không có endpoint getAll users - hiển thị thông báo
      tbody.innerHTML = '<tr><td colspan="7"><div class="empty-state"><i class="fa-solid fa-magnifying-glass"></i><p>Nhập email để tìm kiếm người dùng</p></div></td></tr>';
      return;
    }
    allUsers = data.filter(Boolean);
    renderTable(applyFilter(allUsers));
  } catch(e) {
    tbody.innerHTML = `<tr><td colspan="7"><div class="empty-state"><i class="fa-solid fa-circle-xmark"></i><p>${e.message}</p></div></td></tr>`;
  }
}

function applyFilter(users) {
  const role = document.getElementById('roleFilter').value;
  return role ? users.filter(u => u.role === role) : users;
}

function renderTable(users) {
  const tbody = document.getElementById('userTableBody');
  if (!users.length) {
    tbody.innerHTML = '<tr><td colspan="7"><div class="empty-state"><i class="fa-solid fa-users"></i><p>Không tìm thấy người dùng</p></div></td></tr>';
    return;
  }
  tbody.innerHTML = users.map(u => `
    <tr>
      <td><span class="text-muted" style="font-family:var(--font-mono);font-size:12px">${u.id}</span></td>
      <td><span class="td-main">${u.email}</span></td>
      <td><span class="badge ${roleColors[u.role] || 'badge-gray'}">${roleLabels[u.role] || u.role}</span></td>
      <td><span class="badge ${u.isActive ? 'badge-green' : 'badge-red'}">${u.isActive ? 'Hoạt động' : 'Vô hiệu hóa'}</span></td>
      <td class="text-secondary">${u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleString('vi-VN') : '—'}</td>
      <td class="text-secondary">${new Date(u.createdAt).toLocaleDateString('vi-VN')}</td>
      <td>
        <div style="display:flex;gap:6px">
          <button class="btn btn-secondary btn-sm" onclick="openRoleModal('${u.id}','${u.role}')" title="Đổi vai trò">
            <i class="fa-solid fa-shield"></i>
          </button>
          ${u.isActive ? `<button class="btn btn-danger btn-sm" onclick="deactivate('${u.id}')" title="Vô hiệu hóa">
            <i class="fa-solid fa-ban"></i>
          </button>` : `<span class="badge badge-red">Đã khóa</span>`}
        </div>
      </td>
    </tr>`).join('');
}

function openRoleModal(id, currentRole) {
  document.getElementById('roleUserId').value = id;
  document.getElementById('roleSelect').value = currentRole;
  LMS.modal.open('roleModal');
}

async function saveRole() {
  const userId = document.getElementById('roleUserId').value;
  const role = document.getElementById('roleSelect').value;
  const btn = document.getElementById('saveRoleBtn');
  btn.disabled = true;
  try {
    await LMS.api.patch(`/users/${userId}/role`, { role });
    LMS.toast('Cập nhật vai trò thành công!', 'success');
    LMS.modal.close('roleModal');
    loadUsers();
  } catch(e) { LMS.toast(e.message, 'error'); }
  btn.disabled = false;
}

async function deactivate(userId) {
  if (!LMS.confirm('Vô hiệu hóa tài khoản này?')) return;
  try {
    await LMS.api.patch(`/users/${userId}/deactivate`);
    LMS.toast('Đã vô hiệu hóa tài khoản', 'success');
    loadUsers();
  } catch(e) { LMS.toast(e.message, 'error'); }
}

// Search on enter
document.getElementById('searchInput').addEventListener('keyup', (e) => { if (e.key === 'Enter') loadUsers(); });
document.getElementById('roleFilter').addEventListener('change', () => renderTable(applyFilter(allUsers)));
</script>
