<%- include('../../partials/header', { title: 'Chi tiết bài giảng', activePage: 'courses' }) %>
<%- include('../../partials/sidebar') %>

<div class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <div class="breadcrumb">
        <a href="/courses">Khóa học</a><span>/</span>
        <a href="#" id="brcCourse">—</a><span>/</span>
        <a href="#" id="brcLessons">Bài giảng</a><span>/</span>
        <span class="current" id="brcLesson">—</span>
      </div>
    </div>
  </div>

  <div id="lessonContent" style="text-align:center;padding:80px;color:var(--text-muted)">
    <i class="fa-solid fa-spinner fa-spin" style="font-size:28px;margin-bottom:12px;display:block"></i> Đang tải...
  </div>
</div>

<!-- Modal: Add material -->
<div class="modal-overlay" id="addMaterialModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title"><i class="fa-solid fa-paperclip" style="color:var(--accent);margin-right:8px"></i>Thêm học liệu</div>
      <button class="modal-close" onclick="LMS.modal.close('addMaterialModal')"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="form-group">
      <label class="form-label">Tên file <span style="color:var(--danger)">*</span></label>
      <input type="text" id="matFileName" class="form-control" placeholder="VD: Slide bài 1" maxlength="255" />
    </div>
    <div class="form-group">
      <label class="form-label">Loại file <span style="color:var(--danger)">*</span></label>
      <select id="matFileType" class="form-control">
        <option value="pdf">PDF</option>
        <option value="video">Video</option>
        <option value="audio">Audio</option>
        <option value="image">Hình ảnh</option>
        <option value="document">Tài liệu</option>
        <option value="link">Đường dẫn</option>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">URL <span style="color:var(--danger)">*</span></label>
      <input type="url" id="matFileUrl" class="form-control" placeholder="https://..." />
    </div>
    <div class="form-group">
      <label class="form-label">Dung lượng (KB)</label>
      <input type="number" id="matFileSizeKb" class="form-control" placeholder="Dung lượng file (KB)" min="0" />
    </div>
    <div class="form-actions">
      <button class="btn btn-secondary" onclick="LMS.modal.close('addMaterialModal')">Hủy</button>
      <button class="btn btn-primary" onclick="addMaterial()"><i class="fa-solid fa-plus"></i> Thêm</button>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>

<script>
const pathParts = window.location.pathname.split('/');
const courseId = pathParts[2];
const lessonId = pathParts[4];

const matTypeIcon = { pdf:'fa-file-pdf', video:'fa-video', audio:'fa-headphones', image:'fa-image', document:'fa-file-word', link:'fa-link' };
const matTypeColor = { pdf:'badge-red', video:'badge-blue', audio:'badge-yellow', image:'badge-green', document:'badge-blue', link:'badge-gray' };

document.getElementById('brcLessons').href = `/courses/${courseId}/lessons`;

async function loadLesson() {
  try {
    const [course, lesson] = await Promise.all([
      LMS.api.get(`/courses/${courseId}`),
      LMS.api.get(`/courses/${courseId}/lessons/${lessonId}`),
    ]);
    document.getElementById('brcCourse').textContent = course.title;
    document.getElementById('brcCourse').href = `/courses/${courseId}`;
    document.getElementById('brcLesson').textContent = lesson.title;

    document.getElementById('lessonContent').innerHTML = `
      <div style="display:grid;grid-template-columns:1fr 360px;gap:22px;align-items:start">
        <!-- Left: Lesson info -->
        <div>
          <div class="card" style="margin-bottom:20px">
            <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:16px">
              <div>
                <div style="font-size:11px;color:var(--text-muted);font-family:var(--font-mono);margin-bottom:6px">BÀI GIẢNG #${lesson.order || lessonId}</div>
                <div style="font-size:20px;font-weight:700;color:var(--text-primary)">${lesson.title}</div>
              </div>
              <div style="display:flex;gap:6px">
                <a href="/courses/${courseId}/lessons" class="btn btn-secondary btn-sm"><i class="fa-solid fa-arrow-left"></i></a>
              </div>
            </div>
            ${lesson.content ? `
              <div class="divider"></div>
              <div style="font-size:14px;color:var(--text-secondary);line-height:1.75;white-space:pre-wrap">${lesson.content}</div>` : `
              <div style="padding:20px;text-align:center;color:var(--text-muted);font-size:13px;background:var(--bg-surface);border-radius:8px;border:1px dashed var(--border)">
                <i class="fa-solid fa-file-circle-plus" style="margin-right:6px"></i>Chưa có nội dung bài giảng
              </div>`}
          </div>

          <!-- Materials list -->
          <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
              <div class="card-title" style="margin-bottom:0"><i class="fa-solid fa-paperclip" style="color:var(--accent)"></i> Học liệu (${lesson.materials?.length || 0})</div>
              <button class="btn btn-primary btn-sm" onclick="LMS.modal.open('addMaterialModal')"><i class="fa-solid fa-plus"></i> Thêm</button>
            </div>
            <div id="materialsList">
              ${(lesson.materials || []).length ? lesson.materials.map(m => `
                <div style="display:flex;align-items:center;gap:12px;padding:12px;background:var(--bg-surface);border:1px solid var(--border);border-radius:8px;margin-bottom:8px">
                  <div style="width:36px;height:36px;border-radius:8px;background:var(--bg-card);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <i class="fa-solid ${matTypeIcon[m.fileType] || 'fa-file'}" style="color:var(--accent);font-size:14px"></i>
                  </div>
                  <div style="flex:1;min-width:0">
                    <div style="font-size:13px;font-weight:600;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${m.fileName}</div>
                    <div style="display:flex;gap:8px;margin-top:3px">
                      <span class="badge ${matTypeColor[m.fileType] || 'badge-gray'}" style="font-size:10px">${m.fileType}</span>
                      ${m.fileSizeKb ? `<span style="font-size:11px;color:var(--text-muted)">${m.fileSizeKb > 1024 ? (m.fileSizeKb/1024).toFixed(1)+' MB' : m.fileSizeKb+' KB'}</span>` : ''}
                    </div>
                  </div>
                  <div style="display:flex;gap:6px;flex-shrink:0">
                    <a href="${m.fileUrl}" target="_blank" class="btn btn-secondary btn-sm btn-icon" title="Xem"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>
                    <button class="btn btn-danger btn-sm btn-icon" onclick="deleteMaterial(${m.id})" title="Xóa"><i class="fa-solid fa-trash"></i></button>
                  </div>
                </div>`).join('') : '<div class="empty-state" style="padding:30px"><i class="fa-solid fa-paperclip"></i><p>Chưa có học liệu nào</p></div>'}
            </div>
          </div>
        </div>

        <!-- Right: Nav sidebar -->
        <div class="card" style="position:sticky;top:88px">
          <div class="card-title"><i class="fa-solid fa-list" style="color:var(--accent)"></i> Điều hướng</div>
          <div style="margin-bottom:12px">
            <a href="/courses/${courseId}" class="btn btn-secondary" style="width:100%;justify-content:center;margin-bottom:8px">
              <i class="fa-solid fa-book-open"></i> Về khóa học
            </a>
            <a href="/courses/${courseId}/lessons" class="btn btn-secondary" style="width:100%;justify-content:center">
              <i class="fa-solid fa-list"></i> Tất cả bài giảng
            </a>
          </div>
          <div style="padding:12px;background:var(--bg-surface);border-radius:8px;border:1px solid var(--border)">
            <div style="font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:8px">Thông tin</div>
            <div style="font-size:12px;color:var(--text-secondary);line-height:1.8">
              <div><i class="fa-solid fa-sort-numeric-up" style="width:14px;margin-right:6px;color:var(--text-muted)"></i>Thứ tự: ${lesson.order || '—'}</div>
              <div><i class="fa-solid fa-paperclip" style="width:14px;margin-right:6px;color:var(--text-muted)"></i>Học liệu: ${lesson.materialCount || 0}</div>
              <div><i class="fa-solid fa-book-open" style="width:14px;margin-right:6px;color:var(--text-muted)"></i>Khóa học: #${courseId}</div>
            </div>
          </div>
        </div>
      </div>`;
  } catch(e) {
    document.getElementById('lessonContent').innerHTML = `<div class="empty-state"><i class="fa-solid fa-circle-xmark"></i><p>${e.message}</p></div>`;
  }
}

async function addMaterial() {
  try {
    const body = {
      fileName: document.getElementById('matFileName').value,
      fileType: document.getElementById('matFileType').value,
      fileUrl: document.getElementById('matFileUrl').value,
      fileSizeKb: parseInt(document.getElementById('matFileSizeKb').value) || undefined,
    };
    if (!body.fileName || !body.fileUrl) { LMS.toast('Vui lòng điền đầy đủ thông tin', 'warning'); return; }
    await LMS.api.post(`/lessons/${lessonId}/materials`, body);
    LMS.toast('Thêm học liệu thành công!', 'success');
    LMS.modal.close('addMaterialModal');
    loadLesson();
  } catch(e) { LMS.toast(e.message, 'error'); }
}

async function deleteMaterial(id) {
  if (!LMS.confirm('Xóa học liệu này?')) return;
  try {
    await LMS.api.delete(`/lessons/${lessonId}/materials/${id}`);
    LMS.toast('Đã xóa học liệu!', 'success');
    loadLesson();
  } catch(e) { LMS.toast(e.message, 'error'); }
}

loadLesson();
</script>
