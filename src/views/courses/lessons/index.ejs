<%- include('../../partials/header', { title: 'Bài giảng', activePage: 'courses' }) %>
<%- include('../../partials/sidebar') %>

<div class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <div class="breadcrumb">
        <a href="/courses">Khóa học</a><span>/</span>
        <a href="#" id="brcCourse">—</a><span>/</span>
        <span class="current">Bài giảng</span>
      </div>
    </div>
  </div>

  <div class="page-header">
    <div>
      <div class="page-title">Danh sách bài giảng</div>
      <div class="page-subtitle" id="courseSubtitle">—</div>
    </div>
    <div style="display:flex;gap:8px">
      <a id="backToCourse" href="#" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Về khóa học</a>
      <button class="btn btn-primary" onclick="LMS.modal.open('createLessonModal')"><i class="fa-solid fa-plus"></i> Thêm bài giảng</button>
    </div>
  </div>

  <div id="lessonList" style="display:flex;flex-direction:column;gap:12px">
    <div style="text-align:center;padding:60px;color:var(--text-muted)"><i class="fa-solid fa-spinner fa-spin" style="font-size:24px;margin-bottom:12px;display:block"></i> Đang tải...</div>
  </div>
</div>

<!-- Modal: Create lesson -->
<div class="modal-overlay" id="createLessonModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title"><i class="fa-solid fa-file-alt" style="color:var(--accent);margin-right:8px"></i>Thêm bài giảng</div>
      <button class="modal-close" onclick="LMS.modal.close('createLessonModal')"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="form-group">
      <label class="form-label">Tiêu đề <span style="color:var(--danger)">*</span></label>
      <input type="text" id="lessonTitle" class="form-control" placeholder="VD: Giới thiệu về Python" maxlength="255" />
    </div>
    <div class="form-group">
      <label class="form-label">Nội dung</label>
      <textarea id="lessonContent" class="form-control" placeholder="Nội dung bài giảng..."></textarea>
    </div>
    <div class="form-group">
      <label class="form-label">Thứ tự</label>
      <input type="number" id="lessonOrder" class="form-control" value="1" min="1" />
    </div>
    <div class="form-actions">
      <button class="btn btn-secondary" onclick="LMS.modal.close('createLessonModal')">Hủy</button>
      <button class="btn btn-primary" onclick="createLesson()"><i class="fa-solid fa-plus"></i> Thêm</button>
    </div>
  </div>
</div>

<!-- Modal: Edit lesson -->
<div class="modal-overlay" id="editLessonModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title"><i class="fa-solid fa-pen" style="color:var(--accent);margin-right:8px"></i>Chỉnh sửa bài giảng</div>
      <button class="modal-close" onclick="LMS.modal.close('editLessonModal')"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <input type="hidden" id="editLessonId" />
    <div class="form-group">
      <label class="form-label">Tiêu đề</label>
      <input type="text" id="editLessonTitle" class="form-control" />
    </div>
    <div class="form-group">
      <label class="form-label">Nội dung</label>
      <textarea id="editLessonContent" class="form-control"></textarea>
    </div>
    <div class="form-group">
      <label class="form-label">Thứ tự</label>
      <input type="number" id="editLessonOrder" class="form-control" min="1" />
    </div>
    <div class="form-actions">
      <button class="btn btn-secondary" onclick="LMS.modal.close('editLessonModal')">Hủy</button>
      <button class="btn btn-primary" onclick="updateLesson()"><i class="fa-solid fa-floppy-disk"></i> Lưu</button>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>

<script>
const pathParts = window.location.pathname.split('/');
const courseId = pathParts[2];

document.getElementById('backToCourse').href = `/courses/${courseId}`;
document.getElementById('brcCourse').href = `/courses/${courseId}`;

async function loadLessons() {
  try {
    const [course, lessons] = await Promise.all([
      LMS.api.get(`/courses/${courseId}`),
      LMS.api.get(`/courses/${courseId}/lessons`),
    ]);
    document.getElementById('brcCourse').textContent = course.title;
    document.getElementById('courseSubtitle').textContent = `Khóa học: ${course.title}`;

    const container = document.getElementById('lessonList');
    if (!lessons.length) {
      container.innerHTML = '<div class="empty-state"><i class="fa-solid fa-file-alt"></i><p>Chưa có bài giảng nào. Hãy thêm bài giảng đầu tiên!</p></div>';
      return;
    }
    container.innerHTML = lessons.sort((a,b)=>(a.order||0)-(b.order||0)).map(l => `
      <div class="card" style="display:flex;align-items:center;gap:16px;padding:18px 22px;cursor:pointer;transition:border-color .15s" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="this.style.borderColor='var(--border)'">
        <div style="width:36px;height:36px;flex-shrink:0;border-radius:10px;background:var(--accent-glow);border:1px solid rgba(79,142,247,.3);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent);font-family:var(--font-mono)">${l.order || '—'}</div>
        <div style="flex:1;min-width:0" onclick="window.location.href='/courses/${courseId}/lessons/${l.id}'">
          <div style="font-size:14px;font-weight:600;color:var(--text-primary);margin-bottom:3px">${l.title}</div>
          <div style="font-size:12px;color:var(--text-muted)">
            <i class="fa-solid fa-paperclip" style="margin-right:4px"></i>${l.materialCount || 0} học liệu
          </div>
        </div>
        <div style="display:flex;gap:6px;flex-shrink:0">
          <a href="/courses/${courseId}/lessons/${l.id}" class="btn btn-secondary btn-sm"><i class="fa-solid fa-eye"></i></a>
          <button class="btn btn-secondary btn-sm" onclick="openEdit(${l.id},'${l.title.replace(/'/g,"\\'")}','${(l.content||'').replace(/'/g,"\\'").replace(/\n/g,'\\n')}',${l.order||1})"><i class="fa-solid fa-pen"></i></button>
          <button class="btn btn-danger btn-sm" onclick="deleteLesson(${l.id})"><i class="fa-solid fa-trash"></i></button>
        </div>
      </div>`).join('');
  } catch(e) {
    document.getElementById('lessonList').innerHTML = `<div class="empty-state"><i class="fa-solid fa-circle-xmark"></i><p>${e.message}</p></div>`;
  }
}

async function createLesson() {
  try {
    const title = document.getElementById('lessonTitle').value;
    if (!title) { LMS.toast('Nhập tiêu đề bài giảng', 'warning'); return; }
    await LMS.api.post(`/courses/${courseId}/lessons`, {
      title, content: document.getElementById('lessonContent').value || undefined,
      order: parseInt(document.getElementById('lessonOrder').value) || 1,
    });
    LMS.toast('Thêm bài giảng thành công!', 'success');
    LMS.modal.close('createLessonModal');
    loadLessons();
  } catch(e) { LMS.toast(e.message, 'error'); }
}

function openEdit(id, title, content, order) {
  document.getElementById('editLessonId').value = id;
  document.getElementById('editLessonTitle').value = title;
  document.getElementById('editLessonContent').value = content;
  document.getElementById('editLessonOrder').value = order;
  LMS.modal.open('editLessonModal');
}

async function updateLesson() {
  const id = document.getElementById('editLessonId').value;
  try {
    await LMS.api.put(`/courses/${courseId}/lessons/${id}`, {
      title: document.getElementById('editLessonTitle').value,
      content: document.getElementById('editLessonContent').value || undefined,
      order: parseInt(document.getElementById('editLessonOrder').value) || 1,
    });
    LMS.toast('Cập nhật thành công!', 'success');
    LMS.modal.close('editLessonModal');
    loadLessons();
  } catch(e) { LMS.toast(e.message, 'error'); }
}

async function deleteLesson(id) {
  if (!LMS.confirm('Xóa bài giảng này?')) return;
  try {
    await LMS.api.delete(`/courses/${courseId}/lessons/${id}`);
    LMS.toast('Đã xóa bài giảng!', 'success');
    loadLessons();
  } catch(e) { LMS.toast(e.message, 'error'); }
}

loadLessons();
</script>
