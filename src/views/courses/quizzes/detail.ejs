<%- include('../../partials/header', { title: 'Bài kiểm tra', activePage: 'courses' }) %>
<%- include('../../partials/sidebar') %>

<div class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <div class="breadcrumb">
        <a href="/courses">Khóa học</a><span>/</span>
        <a href="#" id="brcCourse">—</a><span>/</span>
        <span class="current">Bài kiểm tra</span>
      </div>
    </div>
  </div>

  <div class="page-header">
    <div>
      <div class="page-title">Bài kiểm tra</div>
      <div class="page-subtitle" id="courseSubtitle">—</div>
    </div>
    <div style="display:flex;gap:8px">
      <a href="#" id="backBtn" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Về khóa học</a>
      <button class="btn btn-primary" onclick="LMS.modal.open('createQuizModal')"><i class="fa-solid fa-plus"></i> Tạo bài kiểm tra</button>
    </div>
  </div>

  <div id="quizList" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:18px">
    <div style="grid-column:1/-1;text-align:center;padding:60px;color:var(--text-muted)"><i class="fa-solid fa-spinner fa-spin" style="font-size:24px;display:block;margin-bottom:12px"></i> Đang tải...</div>
  </div>
</div>

<!-- Modal: Tạo quiz -->
<div class="modal-overlay" id="createQuizModal">
  <div class="modal" style="max-width:520px">
    <div class="modal-header">
      <div class="modal-title"><i class="fa-solid fa-circle-question" style="color:var(--accent);margin-right:8px"></i>Tạo bài kiểm tra</div>
      <button class="modal-close" onclick="LMS.modal.close('createQuizModal')"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="form-group"><label class="form-label">Tiêu đề <span style="color:var(--danger)">*</span></label><input type="text" id="qTitle" class="form-control" placeholder="VD: Kiểm tra cuối chương 1" /></div>
    <div class="form-group"><label class="form-label">Mô tả</label><textarea id="qDesc" class="form-control" placeholder="Mô tả bài kiểm tra..."></textarea></div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Loại</label>
        <select id="qType" class="form-control">
          <option value="multiple_choice">Trắc nghiệm</option>
          <option value="essay">Tự luận</option>
          <option value="mixed">Kết hợp</option>
        </select>
      </div>
      <div class="form-group"><label class="form-label">Thời gian (phút)</label><input type="number" id="qDuration" class="form-control" placeholder="60" min="1" /></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Điểm tối đa</label><input type="number" id="qMaxScore" class="form-control" placeholder="10" min="0" /></div>
      <div class="form-group"><label class="form-label">Điểm đạt</label><input type="number" id="qPassScore" class="form-control" placeholder="5" min="0" /></div>
    </div>
    <div class="form-group">
      <label class="form-label">Thời gian mở</label>
      <div class="form-row">
        <input type="datetime-local" id="qOpenAt" class="form-control" />
        <input type="datetime-local" id="qCloseAt" class="form-control" />
      </div>
    </div>
    <div class="form-actions">
      <button class="btn btn-secondary" onclick="LMS.modal.close('createQuizModal')">Hủy</button>
      <button class="btn btn-primary" onclick="createQuiz()"><i class="fa-solid fa-plus"></i> Tạo</button>
    </div>
  </div>
</div>

<!-- Modal: Chi tiết quiz -->
<div class="modal-overlay" id="quizDetailModal">
  <div class="modal" style="max-width:600px">
    <div class="modal-header">
      <div class="modal-title" id="quizDetailTitle">Chi tiết bài kiểm tra</div>
      <button class="modal-close" onclick="LMS.modal.close('quizDetailModal')"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div id="quizDetailContent"></div>
  </div>
</div>

<%- include('../../partials/footer') %>

<script>
const pathParts = window.location.pathname.split('/');
const courseId = pathParts[2];

document.getElementById('backBtn').href = `/courses/${courseId}`;

const typeLabels = { multiple_choice:'Trắc nghiệm', essay:'Tự luận', mixed:'Kết hợp' };

async function loadQuizzes() {
  try {
    const [course, quizzes] = await Promise.all([
      LMS.api.get(`/courses/${courseId}`),
      LMS.api.get(`/courses/${courseId}/quizzes`),
    ]);
    document.getElementById('brcCourse').textContent = course.title;
    document.getElementById('brcCourse').href = `/courses/${courseId}`;
    document.getElementById('courseSubtitle').textContent = `Khóa học: ${course.title}`;

    const grid = document.getElementById('quizList');
    if (!quizzes.length) {
      grid.innerHTML = '<div style="grid-column:1/-1"><div class="empty-state"><i class="fa-solid fa-circle-question"></i><p>Chưa có bài kiểm tra nào</p></div></div>';
      return;
    }
    grid.innerHTML = quizzes.map(q => {
      const now = new Date();
      const open = q.openAt ? new Date(q.openAt) : null;
      const close = q.closeAt ? new Date(q.closeAt) : null;
      let status = 'badge-gray', statusLabel = 'Chưa mở';
      if (open && now >= open && (!close || now <= close)) { status = 'badge-green'; statusLabel = 'Đang mở'; }
      else if (close && now > close) { status = 'badge-red'; statusLabel = 'Đã kết thúc'; }
      return `<div class="card" style="transition:all .2s" onmouseenter="this.style.borderColor='var(--accent)'" onmouseleave="this.style.borderColor='var(--border)'">
        <div style="display:flex;justify-content:space-between;margin-bottom:12px">
          <span class="badge badge-blue">${typeLabels[q.quizType] || q.quizType || '—'}</span>
          <span class="badge ${status}">${statusLabel}</span>
        </div>
        <div style="font-size:15px;font-weight:700;color:var(--text-primary);margin-bottom:8px">${q.title}</div>
        <div style="font-size:12px;color:var(--text-secondary);margin-bottom:16px;line-height:1.5">${q.description || 'Không có mô tả'}</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px;padding:12px;background:var(--bg-surface);border-radius:8px;border:1px solid var(--border)">
          <div style="font-size:11px;color:var(--text-muted)">Thời gian<br><strong style="color:var(--text-primary);font-size:13px">${q.durationMinutes ? q.durationMinutes+' phút' : '—'}</strong></div>
          <div style="font-size:11px;color:var(--text-muted)">Điểm tối đa<br><strong style="color:var(--text-primary);font-size:13px">${q.maxScore ?? '—'}</strong></div>
          <div style="font-size:11px;color:var(--text-muted)">Điểm đạt<br><strong style="color:var(--success);font-size:13px">${q.passScore ?? '—'}</strong></div>
          <div style="font-size:11px;color:var(--text-muted)">Câu hỏi<br><strong style="color:var(--text-primary);font-size:13px">${q.questions?.length ?? 0}</strong></div>
        </div>
        <div style="display:flex;gap:8px">
          <button class="btn btn-secondary btn-sm" style="flex:1;justify-content:center" onclick="viewQuiz(${q.id})"><i class="fa-solid fa-eye"></i> Chi tiết</button>
          <button class="btn btn-danger btn-sm btn-icon" onclick="deleteQuiz(${q.id})"><i class="fa-solid fa-trash"></i></button>
        </div>
      </div>`;
    }).join('');
  } catch(e) {
    document.getElementById('quizList').innerHTML = `<div style="grid-column:1/-1"><div class="empty-state"><i class="fa-solid fa-circle-xmark"></i><p>${e.message}</p></div></div>`;
  }
}

async function createQuiz() {
  try {
    const title = document.getElementById('qTitle').value;
    if (!title) { LMS.toast('Nhập tiêu đề bài kiểm tra', 'warning'); return; }
    const body = {
      title,
      description: document.getElementById('qDesc').value || undefined,
      quizType: document.getElementById('qType').value,
      durationMinutes: parseInt(document.getElementById('qDuration').value) || undefined,
      maxScore: parseFloat(document.getElementById('qMaxScore').value) || undefined,
      passScore: parseFloat(document.getElementById('qPassScore').value) || undefined,
      openAt: document.getElementById('qOpenAt').value || undefined,
      closeAt: document.getElementById('qCloseAt').value || undefined,
    };
    await LMS.api.post(`/courses/${courseId}/quizzes`, body);
    LMS.toast('Tạo bài kiểm tra thành công!', 'success');
    LMS.modal.close('createQuizModal');
    loadQuizzes();
  } catch(e) { LMS.toast(e.message, 'error'); }
}

async function viewQuiz(id) {
  try {
    const q = await LMS.api.get(`/courses/${courseId}/quizzes/${id}`);
    document.getElementById('quizDetailTitle').textContent = q.title;
    document.getElementById('quizDetailContent').innerHTML = `
      <div style="font-size:13px;color:var(--text-secondary);margin-bottom:16px">${q.description || ''}</div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px">
        <div style="padding:12px;background:var(--bg-surface);border-radius:8px;text-align:center">
          <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px">Loại</div>
          <div style="font-weight:600">${typeLabels[q.quizType] || q.quizType}</div>
        </div>
        <div style="padding:12px;background:var(--bg-surface);border-radius:8px;text-align:center">
          <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px">Thời gian</div>
          <div style="font-weight:600">${q.durationMinutes ? q.durationMinutes+' phút' : '—'}</div>
        </div>
        <div style="padding:12px;background:var(--bg-surface);border-radius:8px;text-align:center">
          <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px">Điểm đạt</div>
          <div style="font-weight:600;color:var(--success)">${q.passScore ?? '—'}/${q.maxScore ?? '—'}</div>
        </div>
      </div>
      <div class="card-title"><i class="fa-solid fa-list" style="color:var(--accent)"></i> Câu hỏi (${q.questions?.length || 0})</div>
      ${(q.questions || []).length ? q.questions.map((qs, i) => `
        <div style="padding:12px;background:var(--bg-surface);border-radius:8px;margin-bottom:8px;border:1px solid var(--border)">
          <div style="font-size:13px;font-weight:600;margin-bottom:4px">${i+1}. ${qs.content}</div>
          <div style="font-size:11px;color:var(--text-muted)">${qs.points ? qs.points+' điểm' : ''}</div>
        </div>`).join('') : '<div class="empty-state" style="padding:20px"><p>Chưa có câu hỏi</p></div>'}
      <div style="margin-top:16px;display:flex;justify-content:flex-end">
        <a href="/courses/${courseId}/quizzes/${id}/submissions" class="btn btn-secondary">
          <i class="fa-solid fa-file-lines"></i> Xem bài nộp
        </a>
      </div>`;
    LMS.modal.open('quizDetailModal');
  } catch(e) { LMS.toast(e.message, 'error'); }
}

async function deleteQuiz(id) {
  if (!LMS.confirm('Xóa bài kiểm tra này?')) return;
  try {
    await LMS.api.delete(`/courses/${courseId}/quizzes/${id}`);
    LMS.toast('Đã xóa bài kiểm tra!', 'success');
    loadQuizzes();
  } catch(e) { LMS.toast(e.message, 'error'); }
}

loadQuizzes();
</script>
