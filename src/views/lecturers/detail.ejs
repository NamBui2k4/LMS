<%- include('../partials/header', { title: 'Hồ sơ giảng viên', activePage: 'lecturers' }) %>
<%- include('../partials/sidebar') %>

<div class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <div class="breadcrumb">
        <a href="/dashboard">Trang chủ</a><span>/</span>
        <a href="/lecturers">Giảng viên</a><span>/</span>
        <span class="current" id="brcName">Chi tiết</span>
      </div>
    </div>
  </div>

  <div id="detailContent" style="text-align:center;padding:80px;color:var(--text-muted)">
    <i class="fa-solid fa-spinner fa-spin" style="font-size:28px;display:block;margin-bottom:12px"></i> Đang tải...
  </div>
</div>

<%- include('../partials/footer') %>

<script>
const lecturerId = window.location.pathname.split('/')[2];

async function loadDetail() {
  try {
    const [lecturer, createdCourses, assignedCourses] = await Promise.allSettled([
      LMS.api.get(`/lecturers/${lecturerId}`),
      LMS.api.get(`/lecturers/${lecturerId}/created-courses`),
      LMS.api.get(`/lecturers/${lecturerId}/assigned-courses`),
    ]);
    const l = lecturer.value;
    document.getElementById('brcName').textContent = l.fullname || l.email;

    document.getElementById('detailContent').innerHTML = `
      <div style="display:grid;grid-template-columns:280px 1fr;gap:22px;align-items:start">
        <!-- Profile card -->
        <div class="card" style="text-align:center;position:sticky;top:88px">
          <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#7c3aed);display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:700;color:#fff;margin:0 auto 16px">${(l.fullname||l.email||'L')[0]}</div>
          <div style="font-size:18px;font-weight:700;margin-bottom:4px">${l.fullname || '—'}</div>
          <div style="margin-bottom:6px"><span class="badge ${l.status==='active'?'badge-green':'badge-gray'}">${l.status==='active'?'Hoạt động':l.status}</span></div>
          <div style="font-size:13px;color:var(--text-muted);margin-bottom:16px">${l.email}</div>
          ${l.bio ? `<div style="font-size:13px;color:var(--text-secondary);line-height:1.6;text-align:left;padding:12px;background:var(--bg-surface);border-radius:8px;border:1px solid var(--border)">${l.bio}</div>` : ''}
          <div style="display:flex;flex-direction:column;gap:8px;margin-top:16px;text-align:left;font-size:13px;color:var(--text-secondary)">
            ${l.phone ? `<div><i class="fa-solid fa-phone" style="width:20px;color:var(--text-muted)"></i>${l.phone}</div>` : ''}
            ${l.academicDegree ? `<div><i class="fa-solid fa-graduation-cap" style="width:20px;color:var(--text-muted)"></i>${l.academicDegree}</div>` : ''}
            ${l.subject ? `<div><i class="fa-solid fa-chalkboard" style="width:20px;color:var(--text-muted)"></i>${l.subject}</div>` : ''}
            ${l.department ? `<div><i class="fa-solid fa-building" style="width:20px;color:var(--text-muted)"></i>${l.department}</div>` : ''}
          </div>
        </div>

        <!-- Right: courses -->
        <div style="display:flex;flex-direction:column;gap:20px">
          <!-- Stats -->
          <div class="stats-grid" style="grid-template-columns:repeat(2,1fr);margin-bottom:0">
            <div class="stat-card">
              <div><div class="stat-label">KH đã tạo</div><div class="stat-value">${createdCourses.value?.length ?? 0}</div></div>
              <div class="stat-icon" style="background:rgba(79,142,247,.15);color:var(--accent)"><i class="fa-solid fa-book-open"></i></div>
            </div>
            <div class="stat-card">
              <div><div class="stat-label">KH phụ trách</div><div class="stat-value">${assignedCourses.value?.length ?? 0}</div></div>
              <div class="stat-icon" style="background:rgba(52,211,153,.15);color:var(--success)"><i class="fa-solid fa-chalkboard-user"></i></div>
            </div>
          </div>

          <!-- Created courses -->
          <div class="card">
            <div class="card-title"><i class="fa-solid fa-book-open" style="color:var(--accent)"></i> Khóa học đã tạo (${createdCourses.value?.length || 0})</div>
            ${(createdCourses.value||[]).length ? courseTable(createdCourses.value) : '<div class="empty-state" style="padding:30px"><i class="fa-solid fa-book-open"></i><p>Chưa tạo khóa học nào</p></div>'}
          </div>

          <!-- Assigned courses -->
          <div class="card">
            <div class="card-title"><i class="fa-solid fa-chalkboard-user" style="color:#a78bfa"></i> Khóa học được phân công (${assignedCourses.value?.length || 0})</div>
            ${(assignedCourses.value||[]).length ? courseTable(assignedCourses.value) : '<div class="empty-state" style="padding:30px"><i class="fa-solid fa-chalkboard-user"></i><p>Chưa được phân công khóa học nào</p></div>'}
          </div>
        </div>
      </div>`;
  } catch(e) {
    document.getElementById('detailContent').innerHTML = `<div class="empty-state"><i class="fa-solid fa-circle-xmark"></i><p>${e.message}</p></div>`;
  }
}

function courseTable(courses) {
  const statusColors = { draft:'badge-gray', pending:'badge-yellow', published:'badge-green', rejected:'badge-red', archived:'badge-gray' };
  const statusLabels = { draft:'Draft', pending:'Chờ duyệt', published:'Xuất bản', rejected:'Từ chối', archived:'Lưu trữ' };
  return courses.slice(0,5).map(c => `
    <a href="/courses/${c.id}" style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);text-decoration:none">
      <span style="font-size:13px;font-weight:500;color:var(--text-primary)">${c.title}</span>
      <span class="badge ${statusColors[c.status]||'badge-gray'}">${statusLabels[c.status]||c.status}</span>
    </a>`).join('');
}

loadDetail();
</script>
