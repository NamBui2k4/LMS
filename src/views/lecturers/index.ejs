<%- include('../partials/header', { title: 'Giảng viên', activePage: 'lecturers' }) %>
<%- include('../partials/sidebar') %>

<div class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <div class="breadcrumb">
        <a href="/dashboard">Trang chủ</a><span>/</span>
        <span class="current">Giảng viên</span>
      </div>
    </div>
  </div>

  <div class="page-header">
    <div>
      <div class="page-title">Danh sách giảng viên</div>
      <div class="page-subtitle">Quản lý hồ sơ và thống kê giảng dạy</div>
    </div>
    <div class="search-box">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" id="searchInput" placeholder="Tìm giảng viên..." oninput="filterLecturers()" />
    </div>
  </div>

  <div id="lecturerGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px">
    <div style="grid-column:1/-1;text-align:center;padding:60px;color:var(--text-muted)"><i class="fa-solid fa-spinner fa-spin" style="font-size:24px;display:block;margin-bottom:12px"></i> Đang tải...</div>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
let allLecturers = [];

async function loadLecturers() {
  try {
    allLecturers = await LMS.api.get('/lecturers');
    renderLecturers(allLecturers);
  } catch(e) {
    document.getElementById('lecturerGrid').innerHTML = `<div style="grid-column:1/-1"><div class="empty-state"><i class="fa-solid fa-circle-xmark"></i><p>${e.message}</p></div></div>`;
  }
}

function filterLecturers() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  renderLecturers(allLecturers.filter(l => l.fullname?.toLowerCase().includes(q) || l.email?.toLowerCase().includes(q) || l.subject?.toLowerCase().includes(q)));
}

function renderLecturers(list) {
  const grid = document.getElementById('lecturerGrid');
  if (!list.length) {
    grid.innerHTML = '<div style="grid-column:1/-1"><div class="empty-state"><i class="fa-solid fa-chalkboard-user"></i><p>Không tìm thấy giảng viên</p></div></div>';
    return;
  }
  grid.innerHTML = list.map(l => `
    <div class="card" style="transition:all .2s;cursor:pointer" onclick="window.location.href='/lecturers/${l.id}'"
      onmouseenter="this.style.borderColor='var(--accent)';this.style.transform='translateY(-2px)'"
      onmouseleave="this.style.borderColor='var(--border)';this.style.transform='none'">
      <div style="text-align:center;margin-bottom:16px">
        <div style="width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#7c3aed);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;color:#fff;margin:0 auto 12px">${(l.fullname||l.email||'L')[0]}</div>
        <div style="font-size:15px;font-weight:700;color:var(--text-primary)">${l.fullname || '—'}</div>
        <div style="font-size:12px;color:var(--text-secondary);margin-top:2px">${l.email}</div>
      </div>
      <div style="border-top:1px solid var(--border);padding-top:12px;display:flex;flex-direction:column;gap:6px">
        ${l.academicDegree ? `<div style="font-size:12px;color:var(--text-muted)"><i class="fa-solid fa-graduation-cap" style="width:16px;color:var(--accent)"></i> ${l.academicDegree}</div>` : ''}
        ${l.subject ? `<div style="font-size:12px;color:var(--text-muted)"><i class="fa-solid fa-chalkboard" style="width:16px;color:var(--accent)"></i> ${l.subject}</div>` : ''}
        ${l.department ? `<div style="font-size:12px;color:var(--text-muted)"><i class="fa-solid fa-building" style="width:16px;color:var(--accent)"></i> ${l.department}</div>` : ''}
      </div>
      <div style="margin-top:14px">
        <span class="badge ${l.status === 'active' ? 'badge-green' : 'badge-gray'}" style="width:100%;justify-content:center">${l.status === 'active' ? 'Hoạt động' : l.status}</span>
      </div>
    </div>`).join('');
}

loadLecturers();
</script>
