<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LMS — <%= roleType ? (roleType === 'student' ? 'Đăng nhập Người học' : 'Đăng nhập Giảng viên') : 'Chọn vai trò' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .login-page {
      min-height: 100vh; background: var(--bg-base);
      display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem;
    }
    .back-link {
      position: absolute; top: 2rem; left: 2rem;
      display: flex; align-items: center; gap: 6px;
      color: var(--text-muted); text-decoration: none; font-size: 0.875rem;
      transition: color .15s;
    }
    .back-link:hover { color: #fff; }
    .back-link svg { width: 18px; height: 18px; }
    .login-logo { text-align: center; margin-bottom: 2rem; }
    .login-logo img { height: 64px; margin: 0 auto 1rem; display: block; }
    .login-logo h1 { font-size: 1.5rem; font-weight: 700; color: #fff; }
    .login-logo p { color: var(--text-muted); margin-top: 6px; font-size: 0.875rem; }
    .login-card {
      width: 100%; max-width: 448px;
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 14px; padding: 2rem; box-shadow: 0 20px 60px rgba(0,0,0,.4);
    }
    .input-icon-wrap { position: relative; }
    .input-icon-wrap .pre-icon {
      position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
      color: var(--text-muted); pointer-events: none;
    }
    .input-icon-wrap .pre-icon svg { width: 18px; height: 18px; }
    .input-icon-wrap input { padding-left: 2.5rem; }
    .input-icon-wrap .suf-btn {
      position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer; color: var(--text-muted); padding: 4px;
    }
    .input-icon-wrap .suf-btn:hover { color: #fff; }
    .input-icon-wrap .suf-btn svg { width: 18px; height: 18px; }
    .form-row-split { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .form-row-split a { font-size: 0.875rem; color: #58a6ff; text-decoration: none; }
    .form-row-split a:hover { text-decoration: underline; }
    .login-note {
      margin-top: 2rem; padding-top: 1.5rem;
      border-top: 1px solid var(--border); text-align: center;
      font-size: 0.8rem; color: var(--text-muted);
    }
    .login-footer { margin-top: 3rem; font-size: 0.75rem; color: var(--text-muted); text-align: center; }
    .spin-wrap { width: 20px; height: 20px; border: 2px solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: spin 1s linear infinite; }

    /* Style cho trang chọn vai trò */
    .role-card {
      width: 280px; padding: 2.5rem 2rem;
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 14px; text-align: center;
      transition: all 0.3s ease;
      cursor: pointer;
    }
    .role-card:hover {
      transform: translateY(-8px);
      border-color: #6366f1;
      box-shadow: 0 20px 40px rgba(0,0,0,.3);
    }
    .role-icon { font-size: 4rem; margin-bottom: 1rem; }
  </style>
</head>
<body>
<div class="login-page">

  <% if (!roleType) { %>
    <!-- ==================== TRANG CHỌN VAI TRÒ ==================== -->
    <div class="login-logo">
      <img src="/images/logo.png" alt="TDTU Logo" onerror="this.style.display='none'">
      <h1>Chào mừng đến với LMS</h1>
      <p>Vui lòng chọn vai trò để tiếp tục</p>
    </div>

    <div style="display: flex; gap: 24px; flex-wrap: wrap; justify-content: center;">
      <a href="/login/student" style="text-decoration: none;">
        <div class="role-card">
          <div class="role-icon">👨‍🎓</div>
          <h2 style="margin: 0 0 8px 0; color: #fff;">Người học</h2>
          <p style="color: var(--text-muted); margin: 0;">Sinh viên / Học viên</p>
        </div>
      </a>

      <a href="/login/staff" style="text-decoration: none;">
        <div class="role-card">
          <div class="role-icon">👨‍🏫</div>
          <h2 style="margin: 0 0 8px 0; color: #fff;">Giảng viên</h2>
          <p style="color: var(--text-muted); margin: 0;">Giảng viên / Nhân viên</p>
        </div>
      </a>
    </div>

  <% } else { %>
    <!-- ==================== FORM ĐĂNG NHẬP ==================== -->
    <a href="/login" class="back-link">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
      Quay lại lựa chọn
    </a>

    <div class="login-logo">
      <img src="/images/logo.png" alt="TDTU Logo" onerror="this.style.display='none'">
      <h1>Đăng nhập <%= roleType === 'student' ? 'Người học' : 'Giảng viên' %></h1>
      <p>Sử dụng tài khoản hệ thống của bạn</p>
    </div>

    <div class="login-card">
      <form id="login-form" onsubmit="handleLogin(event, '<%= roleType %>')">
        <div class="form-group">
          <label class="form-label">
            <%= roleType === 'student' ? 'Mã số sinh viên' : 'Email công vụ / Mã viên chức' %>
          </label>
          <div class="input-icon-wrap">
            <span class="pre-icon">
              <% if (roleType === 'student') { %>
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <% } else { %>
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <% } %>
            </span>
            <input
              type="text" required
              placeholder="<%= roleType === 'student' ? 'Ví dụ: 52100...' : 'Ví dụ: nguyenvan@tdtu.edu.vn' %>"
              class="form-input"
              id="login-username"
            >
          </div>
        </div>

        <div class="form-group">
          <div class="form-row-split">
            <label class="form-label" style="margin-bottom:0;">Mật khẩu</label>
            <a href="#">Quên mật khẩu?</a>
          </div>
          <div class="input-icon-wrap">
            <span class="pre-icon">
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <input type="password" required placeholder="••••••••" class="form-input" id="login-password">
            <button type="button" class="suf-btn" data-pw-toggle="login-password">
              <span class="eye-on"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></span>
              <span class="eye-off hidden"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg></span>
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-green btn-block" id="login-btn" style="padding:.625rem 1rem;">
          <span id="login-btn-text">Đăng nhập</span>
          <span id="login-spinner" class="spin-wrap hidden"></span>
        </button>
      </form>

      <div class="login-note">
        <% if (roleType === 'student') { %>
          Lưu ý: Sinh viên sử dụng tài khoản được cấp khi nhập học.
        <% } else { %>
          Lưu ý: Giảng viên sử dụng tài khoản Portal để đăng nhập.
        <% } %>
      </div>
    </div>
  <% } %>

  <footer class="login-footer">&copy; 2026 Ton Duc Thang University. All rights reserved.</footer>
</div>

<script src="/js/main.js"></script>
<script>
function handleLogin(e, role) {
  e.preventDefault();
  const btn = document.getElementById('login-btn');
  const txt = document.getElementById('login-btn-text');
  const spin = document.getElementById('login-spinner');
  btn.disabled = true;
  txt.classList.add('hidden');
  spin.classList.remove('hidden');

  setTimeout(() => {
    if (role === 'student') {
      window.location.href = '/student/profile';
    } else {
      window.location.href = '/staff';
    }
  }, 1200);
}
</script>
</body>
</html>