<%- include('partials/header', { title: 'Dashboard', activePage: 'dashboard' }) %>
<%- include('partials/sidebar') %>

<div class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <div class="breadcrumb">
        <i class="fa-solid fa-house" style="font-size:12px"></i>
        <span>/</span>
        <span class="current">Dashboard</span>
      </div>
    </div>
    <div class="topbar-right">
      <div class="topbar-icon-btn" title="Thông báo">
        <i class="fa-solid fa-bell"></i>
        <span class="badge-dot"></span>
      </div>
      <div class="user-pill">
        <div class="avatar"><%= typeof user !== 'undefined' ? user.email[0].toUpperCase() : 'U' %></div>
        <div>
          <div class="uname"><%= typeof user !== 'undefined' ? user.email : 'Người dùng' %></div>
          <div class="urole"><%= typeof user !== 'undefined' ? user.role : '' %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="page-header">
    <div>
      <div class="page-title">Dashboard</div>
      <div class="page-subtitle">Tổng quan hệ thống EduLMS</div>
    </div>
    <div style="font-size:12px;color:var(--text-muted);font-family:var(--font-mono)" id="clockEl"></div>
  </div>

  <!-- Stats -->
  <div class="stats-grid" id="statsGrid">
    <% if (typeof user !== 'undefined' && user.role === 'admin') { %>
    <div class="stat-card">
      <div>
        <div class="stat-label">Tổng người dùng</div>
        <div class="stat-value" id="statUsers">—</div>
      </div>
      <div class="stat-icon" style="background:rgba(79,142,247,.15);color:var(--accent)">
        <i class="fa-solid fa-users"></i>
      </div>
    </div>
    <div class="stat-card">
      <div>
        <div class="stat-label">Trưởng bộ môn</div>
        <div class="stat-value" id="statHeads">—</div>
      </div>
      <div class="stat-icon" style="background:rgba(124,58,237,.15);color:#a78bfa">
        <i class="fa-solid fa-user-tie"></i>
      </div>
    </div>
    <% } %>
    <% if (typeof user !== 'undefined' && (user.role === 'lecturer' || user.role === 'head_of_department' || user.role === 'admin')) { %>
    <div class="stat-card">
      <div>
        <div class="stat-label">Khóa học</div>
        <div class="stat-value" id="statCourses">—</div>
      </div>
      <div class="stat-icon" style="background:rgba(52,211,153,.15);color:var(--success)">
        <i class="fa-solid fa-book-open"></i>
      </div>
    </div>
    <div class="stat-card">
      <div>
        <div class="stat-label">Học viên</div>
        <div class="stat-value" id="statStudents">—</div>
      </div>
      <div class="stat-icon" style="background:rgba(251,191,36,.15);color:var(--warning)">
        <i class="fa-solid fa-user-graduate"></i>
      </div>
    </div>
    <% } %>
  </div>

  <!-- Quick links -->
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px">
    <% if (typeof user !== 'undefined' && (user.role === 'lecturer' || user.role === 'head_of_department')) { %>
    <div class="card">
      <div class="card-title"><i class="fa-solid fa-book-open" style="color:var(--accent)"></i> Khóa học gần đây</div>
      <div id="recentCourses" style="color:var(--text-muted);font-size:13px;text-align:center;padding:20px 0">
        <i class="fa-solid fa-spinner fa-spin"></i> Đang tải...
      </div>
      <div style="margin-top:16px">
        <a href="/courses" class="btn btn-secondary btn-sm" style="width:100%;justify-content:center">
          <i class="fa-solid fa-arrow-right"></i> Xem tất cả
        </a>
      </div>
    </div>
    <% } %>

    <% if (typeof user !== 'undefined' && user.role === 'admin') { %>
    <div class="card">
      <div class="card-title"><i class="fa-solid fa-shield-halved" style="color:#a78bfa"></i> Quản trị nhanh</div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <a href="/admin/users/create" class="btn btn-secondary"><i class="fa-solid fa-user-plus"></i> Tạo tài khoản mới</a>
        <a href="/admin/department-heads" class="btn btn-secondary"><i class="fa-solid fa-user-tie"></i> Quản lý Trưởng bộ môn</a>
        <a href="/categories" class="btn btn-secondary"><i class="fa-solid fa-tags"></i> Quản lý danh mục</a>
      </div>
    </div>
    <% } %>

    <% if (typeof user !== 'undefined' && user.role === 'lecturer') { %>
    <div class="card">
      <div class="card-title"><i class="fa-solid fa-file-lines" style="color:var(--warning)"></i> Bài nộp chờ chấm</div>
      <div id="pendingSubmissions" style="color:var(--text-muted);font-size:13px;text-align:center;padding:20px 0">
        <i class="fa-solid fa-spinner fa-spin"></i> Đang tải...
      </div>
      <div style="margin-top:16px">
        <a href="/submissions" class="btn btn-secondary btn-sm" style="width:100%;justify-content:center">
          <i class="fa-solid fa-arrow-right"></i> Xem tất cả
        </a>
      </div>
    </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>

<script>
  // Clock
  function updateClock() {
    const now = new Date();
    document.getElementById('clockEl').textContent =
      now.toLocaleDateString('vi-VN', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
  }
  updateClock(); setInterval(updateClock, 60000);

  // Load dashboard stats
  async function loadStats() {
    const token = LMS.api.getToken();
    if (!token) return;
    try {
      const [courses, students] = await Promise.allSettled([
        LMS.api.get('/courses'),
        LMS.api.get('/students'),
      ]);
      if (courses.status === 'fulfilled') {
        document.getElementById('statCourses')?.textContent = courses.value?.length ?? 0;
        const el = document.getElementById('recentCourses');
        if (el && courses.value?.length) {
          el.innerHTML = courses.value.slice(0,3).map(c => `
            <a href="/courses/${c.id}" style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);color:var(--text-primary);text-decoration:none">
              <span style="font-weight:500;font-size:13px">${c.title}</span>
              <span class="badge badge-${c.status === 'published' ? 'green' : c.status === 'pending' ? 'yellow' : 'gray'}">${c.status}</span>
            </a>`).join('');
        } else if (el) { el.innerHTML = '<span>Chưa có khóa học nào</span>'; }
      }
      if (students.status === 'fulfilled') {
        document.getElementById('statStudents')?.textContent = students.value?.data?.length ?? students.value?.length ?? 0;
      }
    } catch(e) { console.warn('Stats load error:', e); }
  }
  loadStats();
</script>
