<%- include('partials/header', { title: 'Hồ sơ cá nhân' }) %>
<%- include('partials/sidebar') %>

<div class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <div class="breadcrumb">
        <a href="/dashboard">Trang chủ</a><span>/</span>
        <span class="current">Hồ sơ cá nhân</span>
      </div>
    </div>
    <div class="topbar-right">
      <div class="user-pill">
        <div class="avatar"><%= typeof user !== 'undefined' ? user.email[0].toUpperCase() : 'U' %></div>
        <div>
          <div class="uname"><%= typeof user !== 'undefined' ? user.email : '' %></div>
          <div class="urole"><%= typeof user !== 'undefined' ? user.role : '' %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="page-header">
    <div>
      <div class="page-title">Hồ sơ cá nhân</div>
      <div class="page-subtitle">Thông tin tài khoản của bạn</div>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:280px 1fr;gap:24px;align-items:start">
    <!-- Avatar card -->
    <div class="card" style="text-align:center">
      <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#7c3aed);display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:700;color:#fff;margin:0 auto 16px">
        <span id="avatarInitial">?</span>
      </div>
      <div style="font-size:16px;font-weight:700;margin-bottom:4px" id="profileName">—</div>
      <div style="margin-bottom:16px" id="profileRole"></div>
      <div style="font-size:12px;color:var(--text-muted);margin-bottom:6px" id="profileEmail">—</div>
      <div style="font-size:12px;color:var(--text-muted)" id="profileCreated">—</div>
    </div>

    <!-- Info card -->
    <div class="card">
      <div class="card-title"><i class="fa-solid fa-circle-user" style="color:var(--accent)"></i> Thông tin tài khoản</div>
      <div id="profileInfo" style="color:var(--text-muted);text-align:center;padding:32px">
        <i class="fa-solid fa-spinner fa-spin"></i> Đang tải...
      </div>

      <% if (typeof user !== 'undefined' && user.role === 'lecturer') { %>
      <div class="divider"></div>
      <div class="card-title"><i class="fa-solid fa-pen-to-square" style="color:var(--accent)"></i> Cập nhật thông tin</div>
      <form id="lecturerProfileForm">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Họ tên</label>
            <input type="text" name="fullname" id="f_fullname" class="form-control" placeholder="Nguyễn Văn A" />
          </div>
          <div class="form-group">
            <label class="form-label">Số điện thoại</label>
            <input type="text" name="phone" id="f_phone" class="form-control" placeholder="0901234567" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Học vị</label>
            <input type="text" name="academicDegree" id="f_degree" class="form-control" placeholder="Thạc sĩ, Tiến sĩ..." />
          </div>
          <div class="form-group">
            <label class="form-label">Bộ môn</label>
            <input type="text" name="subject" id="f_subject" class="form-control" placeholder="Công nghệ thông tin" />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Giới thiệu bản thân</label>
          <textarea name="bio" id="f_bio" class="form-control" placeholder="Mô tả ngắn về bản thân..."></textarea>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary" id="saveProfileBtn">
            <i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi
          </button>
        </div>
      </form>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

<script>
async function loadProfile() {
  try {
    const token = LMS.api.getToken();
    if (!token) { window.location.href = '/auth/login'; return; }
    // Decode JWT để lấy userId
    const payload = JSON.parse(atob(token.split('.')[1]));
    const userId = payload.sub || payload.id;
    const role = payload.role;

    document.getElementById('avatarInitial').textContent = (payload.email || 'U')[0].toUpperCase();
    document.getElementById('profileEmail').textContent = payload.email || '';

    const roleLabels = { admin:'Admin', lecturer:'Giảng viên', head_of_department:'Trưởng bộ môn', student:'Học viên' };
    document.getElementById('profileRole').innerHTML = `<span class="badge badge-blue">${roleLabels[role] || role}</span>`;

    if (role === 'lecturer') {
      const data = await LMS.api.get(`/lecturers/${userId}`);
      document.getElementById('profileName').textContent = data.fullname || data.email || '—';
      document.getElementById('profileCreated').textContent = `Tham gia: ${new Date(data.createdAt).toLocaleDateString('vi-VN')}`;
      document.getElementById('profileInfo').innerHTML = `
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px">
          ${infoRow('fa-envelope','Email', data.email)}
          ${infoRow('fa-phone','Điện thoại', data.phone || '—')}
          ${infoRow('fa-graduation-cap','Học vị', data.academicDegree || '—')}
          ${infoRow('fa-chalkboard','Bộ môn', data.subject || '—')}
          ${infoRow('fa-building','Khoa', data.department || '—')}
          ${infoRow('fa-circle-check','Trạng thái', data.status || '—')}
        </div>`;
      // Prefill form
      document.getElementById('f_fullname').value = data.fullname || '';
      document.getElementById('f_phone').value = data.phone || '';
      document.getElementById('f_degree').value = data.academicDegree || '';
      document.getElementById('f_subject').value = data.subject || '';
      document.getElementById('f_bio').value = data.bio || '';
    } else {
      const data = await LMS.api.get(`/users/${userId}`);
      document.getElementById('profileName').textContent = data.email || '—';
      document.getElementById('profileCreated').textContent = `Tham gia: ${new Date(data.createdAt).toLocaleDateString('vi-VN')}`;
      document.getElementById('profileInfo').innerHTML = `
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px">
          ${infoRow('fa-envelope','Email', data.email)}
          ${infoRow('fa-shield','Vai trò', roleLabels[data.role] || data.role)}
          ${infoRow('fa-circle-check','Trạng thái', data.isActive ? 'Đang hoạt động' : 'Bị vô hiệu hóa')}
          ${infoRow('fa-calendar','Ngày tạo', new Date(data.createdAt).toLocaleDateString('vi-VN'))}
        </div>`;
    }
  } catch(e) { console.error(e); }
}

function infoRow(icon, label, value) {
  return `<div style="padding:12px 0;border-bottom:1px solid var(--border)">
    <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px">
      <i class="fa-solid ${icon}" style="margin-right:5px"></i>${label}
    </div>
    <div style="font-size:14px;color:var(--text-primary);font-weight:500">${value}</div>
  </div>`;
}

loadProfile();

// Update lecturer profile
const profileForm = document.getElementById('lecturerProfileForm');
if (profileForm) {
  profileForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('saveProfileBtn');
    btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang lưu...';
    try {
      const token = LMS.api.getToken();
      const payload = JSON.parse(atob(token.split('.')[1]));
      const body = Object.fromEntries(new FormData(profileForm).entries());
      await LMS.api.put(`/lecturers/${payload.sub}`, body);
      LMS.toast('Cập nhật thành công!', 'success');
    } catch(e) { LMS.toast(e.message, 'error'); }
    btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi';
  });
}
</script>
