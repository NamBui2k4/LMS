<%- include('../partials/header', { title: 'Chi tiết học viên', activePage: 'students' }) %>
<%- include('../partials/sidebar') %>

<div class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <div class="breadcrumb">
        <a href="/dashboard">Trang chủ</a><span>/</span>
        <a href="/students">Học viên</a><span>/</span>
        <span class="current" id="brcName">Chi tiết</span>
      </div>
    </div>
  </div>

  <div id="detailContent" style="text-align:center;padding:80px;color:var(--text-muted)">
    <i class="fa-solid fa-spinner fa-spin" style="font-size:28px;display:block;margin-bottom:12px"></i> Đang tải...
  </div>
</div>

<%- include('../partials/footer') %>

<script>
const studentId = window.location.pathname.split('/')[2];

const statusConfig = {
  active:{label:'Hoạt động',color:'badge-green'},
  inactive:{label:'Không HĐ',color:'badge-gray'},
  suspended:{label:'Tạm khóa',color:'badge-yellow'},
  banned:{label:'Bị cấm',color:'badge-red'}
};

async function loadDetail() {
  try {
    const [student, enrollments, submissions] = await Promise.allSettled([
      LMS.api.get(`/students/${studentId}`),
      LMS.api.get(`/students/${studentId}/enrollments`),
      LMS.api.get(`/students/${studentId}/submissions`),
    ]);
    const s = student.value;
    document.getElementById('brcName').textContent = s.fullname || s.email || 'Học viên';
    const st = statusConfig[s.status] || { label:s.status||'—', color:'badge-gray' };

    document.getElementById('detailContent').innerHTML = `
      <div style="display:grid;grid-template-columns:260px 1fr;gap:22px;align-items:start">
        <!-- Avatar card -->
        <div class="card" style="text-align:center;position:sticky;top:88px">
          <div style="width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,var(--success),#059669);display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;color:#fff;margin:0 auto 14px">${(s.fullname||s.email||'S')[0]}</div>
          <div style="font-size:16px;font-weight:700;margin-bottom:4px">${s.fullname || '—'}</div>
          <div style="margin-bottom:8px"><span class="badge ${st.color}">${st.label}</span></div>
          <div style="font-size:13px;color:var(--text-muted)">${s.email || '—'}</div>
          ${s.phone ? `<div style="font-size:13px;color:var(--text-muted);margin-top:4px">${s.phone}</div>` : ''}
          <div style="margin-top:16px;display:flex;gap:8px">
            <a href="/students" class="btn btn-secondary btn-sm" style="flex:1;justify-content:center"><i class="fa-solid fa-arrow-left"></i></a>
          </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:20px">
          <!-- Stats -->
          <div class="stats-grid" style="grid-template-columns:repeat(2,1fr);margin-bottom:0">
            <div class="stat-card">
              <div><div class="stat-label">Ghi danh</div><div class="stat-value">${enrollments.value?.length ?? 0}</div></div>
              <div class="stat-icon" style="background:rgba(52,211,153,.15);color:var(--success)"><i class="fa-solid fa-book-open"></i></div>
            </div>
            <div class="stat-card">
              <div><div class="stat-label">Bài nộp</div><div class="stat-value">${submissions.value?.length ?? 0}</div></div>
              <div class="stat-icon" style="background:rgba(79,142,247,.15);color:var(--accent)"><i class="fa-solid fa-file-lines"></i></div>
            </div>
          </div>

          <!-- Enrollments -->
          <div class="card">
            <div class="card-title"><i class="fa-solid fa-book-open" style="color:var(--success)"></i> Khóa học đã ghi danh</div>
            ${(enrollments.value||[]).length ? enrollments.value.map(e => `
              <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)">
                <div>
                  <div style="font-size:13px;font-weight:500;color:var(--text-primary)">${e.course?.title || 'Khóa học #'+e.courseId}</div>
                  <div style="font-size:11px;color:var(--text-muted);margin-top:2px">${e.enrolledAt ? new Date(e.enrolledAt).toLocaleDateString('vi-VN') : ''}</div>
                </div>
                <span class="badge ${e.status==='active'?'badge-green':'badge-gray'}">${e.status}</span>
              </div>`).join('') : '<div class="empty-state" style="padding:30px"><i class="fa-solid fa-book-open"></i><p>Chưa ghi danh khóa học nào</p></div>'}
          </div>

          <!-- Submissions -->
          <div class="card">
            <div class="card-title"><i class="fa-solid fa-file-lines" style="color:var(--accent)"></i> Bài nộp gần đây</div>
            ${(submissions.value||[]).length ? submissions.value.slice(0,5).map(sub => {
              const scoreColor = sub.score !== null && sub.score !== undefined ? (sub.score >= (sub.quiz?.passScore||5) ? 'var(--success)' : 'var(--danger)') : 'var(--text-muted)';
              return `<div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)">
                <div>
                  <div style="font-size:13px;font-weight:500;color:var(--text-primary)">${sub.quiz?.title || 'Bài kiểm tra #'+sub.quizId}</div>
                  <div style="font-size:11px;color:var(--text-muted);margin-top:2px">${sub.submittedAt ? new Date(sub.submittedAt).toLocaleDateString('vi-VN') : ''}</div>
                </div>
                <div style="text-align:right">
                  <div style="font-size:15px;font-weight:700;color:${scoreColor}">${sub.score !== null && sub.score !== undefined ? sub.score : '—'}</div>
                  <div style="font-size:11px;color:var(--text-muted)">${sub.status || ''}</div>
                </div>
              </div>`;}).join('') : '<div class="empty-state" style="padding:30px"><i class="fa-solid fa-file-lines"></i><p>Chưa có bài nộp</p></div>'}
          </div>
        </div>
      </div>`;
  } catch(e) {
    document.getElementById('detailContent').innerHTML = `<div class="empty-state"><i class="fa-solid fa-circle-xmark"></i><p>${e.message}</p></div>`;
  }
}

loadDetail();
</script>
