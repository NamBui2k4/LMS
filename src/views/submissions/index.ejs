<%- include('../partials/header', { title: 'Bài nộp', activePage: 'submissions' }) %>
<%- include('../partials/sidebar') %>

<div class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <div class="breadcrumb">
        <a href="/dashboard">Trang chủ</a><span>/</span>
        <span class="current">Bài nộp</span>
      </div>
    </div>
  </div>

  <div class="page-header">
    <div>
      <div class="page-title">Bài nộp</div>
      <div class="page-subtitle">Xem và chấm điểm bài nộp của học viên</div>
    </div>
  </div>

  <!-- Filter by quiz -->
  <div class="card" style="margin-bottom:20px;padding:16px 20px">
    <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
      <div style="flex:1;min-width:200px">
        <label class="form-label" style="display:block;margin-bottom:6px">Xem bài nộp theo Quiz ID</label>
        <div style="display:flex;gap:8px">
          <input type="number" id="quizIdInput" class="form-control" placeholder="Nhập ID bài kiểm tra" min="1" style="flex:1" />
          <button class="btn btn-primary" onclick="loadByQuiz()"><i class="fa-solid fa-search"></i> Tìm</button>
        </div>
      </div>
      <div style="flex:1;min-width:200px">
        <label class="form-label" style="display:block;margin-bottom:6px">Hoặc xem theo ID bài nộp</label>
        <div style="display:flex;gap:8px">
          <input type="number" id="subIdInput" class="form-control" placeholder="Nhập ID bài nộp" min="1" style="flex:1" />
          <button class="btn btn-secondary" onclick="loadOne()"><i class="fa-solid fa-eye"></i> Xem</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Status filter -->
  <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap">
    <button class="btn btn-secondary btn-sm" onclick="filterStatus('')">Tất cả</button>
    <button class="btn btn-secondary btn-sm" onclick="filterStatus('submitted')"><i class="fa-solid fa-clock"></i> Chờ chấm</button>
    <button class="btn btn-secondary btn-sm" onclick="filterStatus('graded')"><i class="fa-solid fa-check"></i> Đã chấm</button>
    <button class="btn btn-secondary btn-sm" onclick="filterStatus('regrade_requested')"><i class="fa-solid fa-rotate"></i> Yêu cầu phúc khảo</button>
  </div>

  <div class="card">
    <div id="subInfo" style="font-size:13px;color:var(--text-muted);margin-bottom:14px"></div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>ID</th><th>Học viên</th><th>Quiz</th><th>Ngày nộp</th><th>Trạng thái</th><th>Điểm</th><th>Thao tác</th></tr>
        </thead>
        <tbody id="subTableBody">
          <tr><td colspan="7"><div class="empty-state"><i class="fa-solid fa-file-lines"></i><p>Nhập Quiz ID để xem danh sách bài nộp</p></div></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal: Chấm điểm -->
<div class="modal-overlay" id="gradeModal">
  <div class="modal" style="max-width:560px">
    <div class="modal-header">
      <div class="modal-title"><i class="fa-solid fa-pen-to-square" style="color:var(--accent);margin-right:8px"></i>Chấm điểm bài nộp</div>
      <button class="modal-close" onclick="LMS.modal.close('gradeModal')"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <input type="hidden" id="gradeSubId" />
    <div id="gradeAnswers" style="max-height:300px;overflow-y:auto;margin-bottom:16px;padding-right:4px"></div>
    <div class="divider"></div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Điểm số <span style="color:var(--danger)">*</span></label>
        <input type="number" id="gradeScore" class="form-control" placeholder="0.0" min="0" step="0.5" />
      </div>
      <div class="form-group">
        <label class="form-label">Phản hồi</label>
        <input type="text" id="gradeFeedback" class="form-control" placeholder="Nhận xét cho học viên..." />
      </div>
    </div>
    <div class="form-actions">
      <button class="btn btn-secondary" onclick="LMS.modal.close('gradeModal')">Hủy</button>
      <button class="btn btn-primary" onclick="submitGrade()"><i class="fa-solid fa-check"></i> Chấm điểm</button>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
const statusConfig = {
  submitted:         { label:'Chờ chấm',        color:'badge-yellow' },
  graded:            { label:'Đã chấm',          color:'badge-green'  },
  regrade_requested: { label:'Yêu cầu phúc khảo',color:'badge-blue'  },
};
let allSubs = [];

async function loadByQuiz() {
  const quizId = document.getElementById('quizIdInput').value;
  if (!quizId) { LMS.toast('Nhập Quiz ID', 'warning'); return; }
  const tbody = document.getElementById('subTableBody');
  tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:30px;color:var(--text-muted)"><i class="fa-solid fa-spinner fa-spin"></i></td></tr>';
  try {
    allSubs = await LMS.api.get(`/quizzes/${quizId}/submissions`);
    document.getElementById('subInfo').textContent = `Quiz #${quizId} — ${allSubs.length} bài nộp`;
    renderTable(allSubs);
  } catch(e) {
    tbody.innerHTML = `<tr><td colspan="7"><div class="empty-state"><i class="fa-solid fa-circle-xmark"></i><p>${e.message}</p></div></td></tr>`;
  }
}

async function loadOne() {
  const id = document.getElementById('subIdInput').value;
  if (!id) { LMS.toast('Nhập ID bài nộp', 'warning'); return; }
  try {
    const sub = await LMS.api.get(`/submissions/${id}`);
    allSubs = [sub];
    document.getElementById('subInfo').textContent = `Bài nộp #${id}`;
    renderTable(allSubs);
  } catch(e) { LMS.toast(e.message, 'error'); }
}

function filterStatus(status) {
  renderTable(status ? allSubs.filter(s => s.status === status) : allSubs);
}

function renderTable(subs) {
  const tbody = document.getElementById('subTableBody');
  if (!subs.length) {
    tbody.innerHTML = '<tr><td colspan="7"><div class="empty-state"><i class="fa-solid fa-file-lines"></i><p>Không có bài nộp</p></div></td></tr>';
    return;
  }
  tbody.innerHTML = subs.map(s => {
    const st = statusConfig[s.status] || { label:s.status||'—', color:'badge-gray' };
    const scoreColor = s.score !== null && s.score !== undefined ? (s.score >= (s.quiz?.passScore||5) ? 'var(--success)' : 'var(--danger)') : 'var(--text-muted)';
    return `<tr>
      <td class="text-muted" style="font-family:var(--font-mono);font-size:12px">${s.id}</td>
      <td><span class="td-main">${s.student?.fullname || 'HV #'+s.studentId}</span></td>
      <td class="text-secondary">${s.quiz?.title || 'Quiz #'+s.quizId}</td>
      <td class="text-secondary">${s.submittedAt ? new Date(s.submittedAt).toLocaleString('vi-VN') : '—'}</td>
      <td><span class="badge ${st.color}">${st.label}</span></td>
      <td><strong style="color:${scoreColor};font-family:var(--font-mono)">${s.score !== null && s.score !== undefined ? s.score : '—'}</strong></td>
      <td>
        <div style="display:flex;gap:6px">
          ${s.status !== 'graded' ? `<button class="btn btn-primary btn-sm" onclick="openGrade(${s.id})"><i class="fa-solid fa-pen"></i> Chấm</button>` : ''}
          <button class="btn btn-secondary btn-sm" onclick="viewDetail(${s.id})"><i class="fa-solid fa-eye"></i></button>
        </div>
      </td>
    </tr>`;
  }).join('');
}

async function openGrade(id) {
  try {
    const sub = await LMS.api.get(`/submissions/${id}`);
    document.getElementById('gradeSubId').value = id;
    document.getElementById('gradeScore').value = sub.score || '';
    document.getElementById('gradeFeedback').value = sub.feedback || '';
    document.getElementById('gradeAnswers').innerHTML = sub.answers?.length ? sub.answers.map((a, i) => `
      <div style="padding:10px;background:var(--bg-surface);border-radius:8px;margin-bottom:8px;border:1px solid var(--border)">
        <div style="font-size:12px;color:var(--text-muted);margin-bottom:4px">Câu ${i+1}</div>
        <div style="font-size:13px;color:var(--text-primary)">${a.answer || a}</div>
      </div>`).join('') : '<div style="text-align:center;padding:16px;color:var(--text-muted);font-size:13px">Không có dữ liệu câu trả lời</div>';
    LMS.modal.open('gradeModal');
  } catch(e) { LMS.toast(e.message, 'error'); }
}

async function submitGrade() {
  const id = document.getElementById('gradeSubId').value;
  const score = parseFloat(document.getElementById('gradeScore').value);
  if (isNaN(score)) { LMS.toast('Nhập điểm hợp lệ', 'warning'); return; }
  try {
    await LMS.api.patch(`/submissions/${id}/grade`, {
      score,
      feedback: document.getElementById('gradeFeedback').value || undefined,
    });
    LMS.toast('Chấm điểm thành công!', 'success');
    LMS.modal.close('gradeModal');
    const quizId = document.getElementById('quizIdInput').value;
    if (quizId) loadByQuiz();
  } catch(e) { LMS.toast(e.message, 'error'); }
}

async function viewDetail(id) {
  try {
    const sub = await LMS.api.get(`/submissions/${id}`);
    alert(`Bài nộp #${id}\nHọc viên: ${sub.student?.fullname || sub.studentId}\nĐiểm: ${sub.score ?? 'Chưa chấm'}\nPhản hồi: ${sub.feedback || '—'}`);
  } catch(e) { LMS.toast(e.message, 'error'); }
}

// Enter key for quiz search
document.getElementById('quizIdInput').addEventListener('keyup', e => { if (e.key === 'Enter') loadByQuiz(); });
</script>
