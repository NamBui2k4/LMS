<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LMS — Chọn đối tượng đăng nhập</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .role-page {
      min-height: 100vh;
      background: var(--bg-base);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: 2rem;
    }
    .role-hero { text-align: center; margin-bottom: 3rem; }
    .role-hero img { height: 80px; margin: 0 auto 1rem; display: block; }
    .role-hero-text { font-size: 1.125rem; color: var(--text-muted); }
    .role-hero-text .highlight { color: #ef4444; font-weight: 700; text-transform: uppercase; }

    .role-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 3rem; max-width: 900px; width: 100%; }
    @media(max-width:640px){ .role-grid{grid-template-columns:1fr;gap:1.5rem;} }

    .role-card {
      cursor: pointer;
      border-radius: 18px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      padding: 2rem;
      transition: all .3s ease;
      overflow: hidden;
    }
    .role-card:hover {
      transform: translateY(-4px);
    }
    .role-card.staff:hover {
      border-color: #3b82f6;
      box-shadow: 0 0 24px rgba(59,130,246,.2);
    }
    .role-card.student:hover {
      border-color: #22c55e;
      box-shadow: 0 0 24px rgba(34,197,94,.2);
    }
    .role-card .img-wrap {
      overflow: hidden; border-radius: 8px; margin-bottom: 1.5rem; height: 196px;
      display: flex; align-items: center; justify-content: center; background: #0d1117;
    }
    .role-card img.role-img {
      width: 100%; height: 100%; object-fit: contain;
      filter: grayscale(1); transition: all .5s ease;
    }
    .role-card:hover img.role-img {
      filter: grayscale(0); transform: scale(1.08) rotate(2deg);
    }
    .role-card-title { font-size: 1.25rem; font-weight: 700; color: #fff; text-align: center; margin-bottom: 8px; }
    .role-card-desc { font-size: 0.875rem; color: var(--text-muted); text-align: center; }

    /* Placeholder illustration when no image */
    .role-placeholder {
      width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
      font-size: 5rem;
    }
  </style>
</head>
<body>
<div class="role-page">
  <!-- Logo & heading -->
  <div class="role-hero">
    <img src="/images/logo.png" alt="TDTU Logo" onerror="this.style.display='none'">
    <p class="role-hero-text">
      Hãy <span class="highlight">chọn đối tượng</span> để <span class="highlight">đăng nhập</span> vào hệ thống
    </p>
  </div>

  <!-- Role cards -->
  <div class="role-grid">
    <!-- Staff card -->
    <div class="role-card staff" data-href="/login/staff" onclick="window.location.href='/login/staff'">
      <div class="img-wrap">
        <img src="/images/Lecturer.png" alt="Giảng viên" class="role-img"
             onerror="this.parentElement.innerHTML='<div class=\'role-placeholder\'>👨‍🏫</div>'">
      </div>
      <h2 class="role-card-title">Giảng viên - Viên chức</h2>
      <p class="role-card-desc">Nếu là Giảng viên - Viên chức hãy click vào đây để đăng nhập.</p>
    </div>

    <!-- Student card -->
    <div class="role-card student" data-href="/login/student" onclick="window.location.href='/login/student'">
      <div class="img-wrap">
        <img src="/images/StudentGraduation.png" alt="Người học" class="role-img"
             onerror="this.parentElement.innerHTML='<div class=\'role-placeholder\'>🎓</div>'">
      </div>
      <h2 class="role-card-title">Người học</h2>
      <p class="role-card-desc">Nếu là Người học hãy click vào đây để đăng nhập.</p>
    </div>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
