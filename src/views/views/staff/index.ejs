<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>LMS Staff — Tổng quan</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="layout">
  <%- include('../partials/staff-topbar') %>
  <div class="layout-body">
    <%- include('../partials/staff-sidebar', { activeMenu: 'profile' }) %>
    <main class="layout-main">
      <div class="max-content">

        <div class="page-header">
          <h1 class="page-title" style="display:flex;align-items:center;gap:8px;">
            <svg width="22" height="22" fill="none" stroke="#238636" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            Tổng quan Giảng dạy — HK2 2526
          </h1>
        </div>

        <div class="grid-3 mb-8">
          <div class="stat-card">
            <div class="stat-label">Lớp học đang phụ trách</div>
            <div class="stat-value text-white">4</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Bài tập cần chấm</div>
            <div class="stat-value text-orange">128</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Tin nhắn chưa đọc</div>
            <div class="stat-value text-blue">5</div>
          </div>
        </div>

        <!-- Quick links -->
        <div class="grid-2">
          <div class="card">
            <div class="card-header"><h3 style="font-weight:600;color:#fff;">Lớp học sắp tới</h3></div>
            <div class="card-body">
              <% const upcoming = [
                { course:'IT001', name:'Nhập môn Lập trình', time:'Thứ 2, 07:00 - 09:00', room:'B1-301' },
                { course:'IT004', name:'Phát triển Ứng dụng Web', time:'Thứ 4, 13:00 - 15:00', room:'B2-201' },
              ]; %>
              <% upcoming.forEach(function(cls){ %>
              <div style="display:flex;align-items:center;gap:12px;padding:.75rem 0;border-bottom:1px solid var(--border);">
                <div style="width:40px;height:40px;border-radius:8px;background:rgba(35,134,54,.15);border:1px solid rgba(35,134,54,.3);display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:700;color:#3fb950;font-family:monospace;"><%= cls.course %></div>
                <div>
                  <div style="font-weight:500;color:#fff;font-size:.875rem;"><%= cls.name %></div>
                  <div style="font-size:.75rem;color:var(--text-muted);"><%= cls.time %> • Phòng: <%= cls.room %></div>
                </div>
              </div>
              <% }) %>
            </div>
          </div>

          <div class="card">
            <div class="card-header"><h3 style="font-weight:600;color:#fff;">Bài cần chấm gần đây</h3></div>
            <div class="card-body">
              <% const toGrade = [
                { student:'Nguyễn Văn A', quiz:'Báo cáo Đồ án giữa kỳ', time:'29/03/2026 14:30' },
                { student:'Trần Thị B', quiz:'Bài tập Thực hành React', time:'28/03/2026 09:15', flag:'regrade' },
              ]; %>
              <% toGrade.forEach(function(item){ %>
              <div style="display:flex;align-items:flex-start;justify-content:space-between;padding:.75rem 0;border-bottom:1px solid var(--border);">
                <div>
                  <div style="font-weight:500;color:#fff;font-size:.875rem;"><%= item.student %></div>
                  <div style="font-size:.75rem;color:var(--text-muted);margin-top:2px;"><%= item.quiz %></div>
                  <div style="font-size:.7rem;color:var(--text-muted);">Nộp: <%= item.time %></div>
                </div>
                <% if (item.flag === 'regrade') { %>
                  <span class="badge badge-red" style="font-size:.65rem;animation:pulse 2s infinite;">Phúc khảo</span>
                <% } else { %>
                  <span class="badge badge-yellow">Chờ chấm</span>
                <% } %>
              </div>
              <% }) %>
              <div style="margin-top:1rem;">
                <a href="/staff/grading" class="btn btn-ghost btn-sm btn-block" style="justify-content:center;">Xem tất cả bài nộp</a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </main>
  </div>
  <footer class="layout-footer">
    <span>Copyright © 2026 TDTU. All rights reserved.</span>
    <span>Portal Giảng Viên v2.1</span>
  </footer>
</div>
<script src="/js/main.js"></script>
</body>
</html>
